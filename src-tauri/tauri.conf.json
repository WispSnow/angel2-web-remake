{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Angel2 Web Remake",
  "version": "0.1.0",
  "identifier": "com.wispsnow.angel2-web-remake",
  "build": {
    "frontendDist": "../release",
    "devUrl": "http://127.0.0.1:4173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:release"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "天使帝國 II Web 復刻版",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

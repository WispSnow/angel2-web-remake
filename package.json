{
  "name": "angel2-web-remake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:arena": "vite --host 127.0.0.1 --open /arena.html",
    "dev:classes": "vite --host 127.0.0.1 --open /class-showdown.html",
    "dev:promotions": "vite --host 127.0.0.1 --open /promotion-lab.html",
    "dev:debug": "vite --host 127.0.0.1 --open /debug.html",
    "dev:combat": "vite --host 127.0.0.1 --open /combat-lab.html",
    "dev:deployment": "vite --host 127.0.0.1 --open /deployment-lab.html",
    "dev:portraits": "vite --host 127.0.0.1 --open /portrait-lab.html",
    "dev:techniques": "vite --host 127.0.0.1 --open /technique-lab.html",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:visual": "VISUAL_AUDIT=1 playwright test",
    "docs:check": "node scripts/check-project-contracts.mjs",
    "check": "pnpm run docs:check && pnpm run test:coverage && pnpm run build && pnpm run test:e2e",
    "content": "node scripts/generate-content.mjs",
    "content:classes": "node scripts/generate-class-catalog.mjs",
    "content:portraits": "node scripts/generate-portrait-catalog.mjs",
    "content:stage0": "node scripts/generate-stage0-runtime.mjs",
    "content:stage1": "node scripts/generate-stage1-runtime.mjs",
    "content:stage2": "node scripts/generate-stage2-runtime.mjs",
    "content:stage3": "node scripts/generate-stage3-runtime.mjs",
    "content:stage4": "node scripts/generate-stage4-runtime.mjs",
    "content:stage5": "node scripts/generate-stage5-runtime.mjs",
    "content:stage6": "node scripts/generate-stage6-runtime.mjs",
    "content:stage7": "node scripts/generate-stage7-runtime.mjs",
    "content:stage8": "node scripts/generate-stage8-runtime.mjs",
    "content:stage9": "node scripts/generate-stage9-runtime.mjs",
    "content:stage10": "node scripts/generate-stage10-runtime.mjs",
    "content:stage11": "node scripts/generate-stage11-runtime.mjs",
    "content:stage12": "node scripts/generate-stage12-runtime.mjs",
    "content:stage13": "node scripts/generate-stage13-runtime.mjs",
    "content:stage14": "node scripts/generate-stage14-runtime.mjs",
    "content:stage15": "node scripts/generate-stage15-runtime.mjs",
    "content:stage16": "node scripts/generate-stage16-runtime.mjs",
    "content:stage17": "node scripts/generate-stage17-runtime.mjs",
    "content:actions": "node scripts/generate-stage0-actions.mjs && node scripts/generate-stage1-actions.mjs",
    "content:terrain-actions": "node scripts/generate-dynamic-terrain-assets.mjs",
    "content:ai-dialogue": "node scripts/generate-ai-technique-dialogue.mjs",
    "content:technique-lab": "node scripts/generate-technique-lab.mjs",
    "content:music": "node scripts/generate-stage0-music.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.0.18",
    "iconv-lite": "0.7.3",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vitest": "4.0.18"
  },
  "packageManager": "pnpm@11.9.0"
}

{
  "name": "angel2-web-remake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:debug": "vite --host 127.0.0.1 --open /debug.html",
    "dev:combat": "vite --host 127.0.0.1 --open /combat-lab.html",
    "dev:deployment": "vite --host 127.0.0.1 --open /deployment-lab.html",
    "dev:portraits": "vite --host 127.0.0.1 --open /portrait-lab.html",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm run test:coverage && pnpm run build && pnpm run test:e2e",
    "content": "pnpm run content:classes && pnpm run content:portraits && pnpm run content:stage0 && pnpm run content:stage1 && pnpm run content:actions && pnpm run content:music",
    "content:classes": "node scripts/generate-class-catalog.mjs",
    "content:portraits": "node scripts/generate-portrait-catalog.mjs",
    "content:stage0": "node scripts/generate-stage0-runtime.mjs",
    "content:stage1": "node scripts/generate-stage1-runtime.mjs",
    "content:actions": "node scripts/generate-stage0-actions.mjs && node scripts/generate-stage1-actions.mjs",
    "content:music": "node scripts/generate-stage0-music.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.0.18",
    "iconv-lite": "0.7.3",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vitest": "4.0.18"
  },
  "packageManager": "pnpm@11.9.0"
}
